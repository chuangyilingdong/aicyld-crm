# Twenty 版本：固定版本号，升级时只改这里
TAG=v2.56.1

# 必须和浏览器地址完全一致，结尾不要带 /
SERVER_URL=https://crm.aicyld.com

# PostgreSQL
PG_DATABASE_USER=postgres
PG_DATABASE_PASSWORD=__PG_PASSWORD__
PG_DATABASE_HOST=db
PG_DATABASE_PORT=5432
PG_DATABASE_NAME=default

# Redis
REDIS_URL=redis://redis:6379
REDIS_CACHE_PREFIX=

# 密钥：部署脚本会自动生成；不要提交真实值
ENCRYPTION_KEY=__ENCRYPTION_KEY__
APP_SECRET=__APP_SECRET__

# 存储：先用本地卷；以后要上 S3/OSS 再改
STORAGE_TYPE=local
TZ=Asia/Shanghai

# 可选 S3/OSS
# STORAGE_S3_REGION=
# STORAGE_S3_NAME=
# STORAGE_S3_ENDPOINT=
# STORAGE_S3_ACCESS_KEY_ID=
# STORAGE_S3_SECRET_ACCESS_KEY=
