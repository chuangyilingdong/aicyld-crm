# Twenty CRM 反向代理
# 说明：3000 只绑 127.0.0.1，公网只走 443；WebSocket 用于实时更新。
server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name __DOMAIN__;

    ssl_certificate /etc/letsencrypt/live/__DOMAIN__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__DOMAIN__/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    server_tokens off;
    client_max_body_size 50m;
    gzip_proxied any;
    gzip_types text/plain text/css text/javascript application/javascript application/json application/xml text/xml application/xml+rss image/svg+xml;
    location = /crm-rounds-panel.js {
        alias /opt/twenty/crm-rounds-panel.js;
        default_type application/javascript;
        add_header Cache-Control "no-cache";
    }

    location = /crm-insights.js {
        alias /opt/twenty/nginx/crm-insights.js;
        default_type application/javascript;
        add_header Cache-Control "no-cache";
    }

    location = /crm-map.js {
        alias /opt/twenty/nginx/crm-map.js;
        default_type application/javascript;
        add_header Cache-Control "no-cache";
    }

    location = /crm-map/crm-map.css {
        alias /opt/twenty/nginx/crm-map/crm-map.css;
        default_type text/css;
        add_header Cache-Control "no-cache";
    }

    location = /crm-map/maplibre-gl-5.9.0.js {
        alias /opt/twenty/nginx/crm-map/maplibre-gl-5.9.0.js;
        default_type application/javascript;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location = /crm-map/maplibre-gl-5.9.0.css {
        alias /opt/twenty/nginx/crm-map/maplibre-gl-5.9.0.css;
        default_type text/css;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # 经销商地图资源：GeoJSON / 城市中心点 / 演示页
    location /crm-map/ {
        alias /opt/twenty/nginx/crm-map/;
        add_header Cache-Control "public, max-age=86400";
    }


    # 前端带 hash 的静态资源：长期缓存 + gzip，减少每次跳转的请求量
    location /assets/ {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_hide_header Cache-Control;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Accept-Encoding "";
        sub_filter '</body>' '<script src="/crm-rounds-panel.js" defer></script><script src="/crm-insights.js" defer></script><script src="/crm-map.js" defer></script></body>';
        sub_filter_once on;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 300s;
        proxy_connect_timeout 300s;
        proxy_send_timeout 300s;
    }
}
